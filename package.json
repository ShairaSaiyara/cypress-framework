{
  "name": "cypress-framework",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npx cypress run",
    "cypress:open": "npx cypress open",
    "clean:reports": "rimraf cypress/reports && mkdir cypress\\reports",
    "merge:reports": "npx mochawesome-merge \"cypress/reports/mochawesome*.json\" > cypress/reports/output.json",
    "generate:report": "npx marge cypress/reports/output.json --reportDir cypress/reports/html --reportFilename index.html",
    "test:report": "npm run clean:reports && npm run test && npm run merge:reports && npm run generate:report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "cypress": "^15.16.0",
    "cypress-terminal-report": "^7.3.3",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "rimraf": "^6.1.3"
  }
}
